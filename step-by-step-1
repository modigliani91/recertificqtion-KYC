"""
================================================================================
 ETAPE 1 - PREPARATION DES DOSSIERS KYC
================================================================================
1. Dezippe kyc_docs.zip
2. Pour chaque dossier client, verifie la presence des 5 documents requis
3. IMPORTANT (nouveau comportement) : ne copie dans kyc_documents_cibles/ que
   les dossiers clients COMPLETS (les 5 documents presents). Les dossiers
   incomplets ne sont PAS copies, mais restent tracés dans le rapport pour
   audit / relance client.
4. Genere rapport_presence_kyc.csv : statut de CHAQUE client (complet/incomplet
   + liste des documents manquants)
================================================================================
"""

import zipfile
import shutil
import csv
import re
import unicodedata
from pathlib import Path


# ------------------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------------------
ZIP_PATH = Path("kyc_docs.zip")
EXTRACT_DIR = Path("kyc_extracted")
OUTPUT_DIR = Path("kyc_documents_cibles")           # ne contiendra QUE les dossiers complets
REPORT_PATH = Path("rapport_presence_kyc.csv")

TARGET_DOCS = {
    "JUSTIFICATIF IDENTITE": ["justificatif identite"],
    "JUSTIFICATIF DOMICILE": ["justificatif domicile"],
    "CONVENTION COMPTE": ["convention compte"],
    "FATCA": ["fatca"],
    "CARTON SIGNATURE": ["carton signatute", "carton signature"],
}


def normaliser(texte: str) -> str:
    texte = texte.lower()
    texte = unicodedata.normalize("NFKD", texte).encode("ascii", "ignore").decode("utf-8")
    texte = re.sub(r"\.pdf$", "", texte)
    texte = re.sub(r"[^a-z0-9]+", " ", texte)
    texte = re.sub(r"\s+", " ", texte).strip()
    return texte


def dezipper(zip_path: Path, extract_dir: Path) -> None:
    if not zip_path.exists():
        raise FileNotFoundError(f"Archive introuvable : {zip_path}")
    extract_dir.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(zip_path, "r") as archive:
        archive.extractall(extract_dir)
    print(f"[OK] Archive dezippee dans : {extract_dir.resolve()}")


def lister_dossiers_clients(extract_dir: Path) -> list[Path]:
    contenu = [p for p in extract_dir.iterdir() if p.is_dir()]
    if len(contenu) == 1 and contenu[0].is_dir():
        sous_contenu = [p for p in contenu[0].iterdir() if p.is_dir()]
        if sous_contenu:
            return sous_contenu
    return contenu


def trouver_documents_cibles(dossier_client: Path) -> dict:
    pdfs = list(dossier_client.rglob("*.pdf")) + list(dossier_client.rglob("*.PDF"))
    resultats = {nom: None for nom in TARGET_DOCS}
    for pdf in pdfs:
        nom_normalise = normaliser(pdf.stem)
        for nom_cible, variantes in TARGET_DOCS.items():
            if resultats[nom_cible] is not None:
                continue
            if any(normaliser(v) == nom_normalise for v in variantes):
                resultats[nom_cible] = pdf
    return resultats


def copier_documents(client_id: str, resultats: dict, output_dir: Path) -> None:
    dossier_sortie = output_dir / client_id
    dossier_sortie.mkdir(parents=True, exist_ok=True)
    for nom_cible, chemin_source in resultats.items():
        shutil.copy2(chemin_source, dossier_sortie / f"{nom_cible}.pdf")


def main():
    dezipper(ZIP_PATH, EXTRACT_DIR)
    dossiers_clients = lister_dossiers_clients(EXTRACT_DIR)
    print(f"[INFO] {len(dossiers_clients)} dossier(s) client trouve(s).")

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    lignes_rapport = []
    noms_colonnes = ["client_id", "statut"] + list(TARGET_DOCS.keys()) + ["documents_manquants"]

    nb_complets = 0
    for dossier in sorted(dossiers_clients):
        client_id = dossier.name
        resultats = trouver_documents_cibles(dossier)

        manquants = [nom for nom, chemin in resultats.items() if chemin is None]
        est_complet = len(manquants) == 0

        # --- LE POINT IMPORTANT : on ne copie QUE si le dossier est complet ---
        if est_complet:
            copier_documents(client_id, resultats, OUTPUT_DIR)
            nb_complets += 1

        ligne = {"client_id": client_id, "statut": "Complet" if est_complet else "Incomplet"}
        for nom in TARGET_DOCS:
            ligne[nom] = "Oui" if resultats[nom] is not None else "Non"
        ligne["documents_manquants"] = ", ".join(manquants) if manquants else "Aucun"
        lignes_rapport.append(ligne)

    with open(REPORT_PATH, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=noms_colonnes, delimiter=";")
        writer.writeheader()
        writer.writerows(lignes_rapport)

    total = len(lignes_rapport)
    print(f"[OK] Rapport genere : {REPORT_PATH.resolve()}")
    print(f"[OK] Dossiers copies dans {OUTPUT_DIR.resolve()} (uniquement les complets)")
    print(f"[RESUME] {nb_complets}/{total} dossiers clients complets et disponibles pour la suite du traitement.")
    print(f"[RESUME] {total - nb_complets}/{total} dossiers incomplets -> NON copies, voir rapport pour relance.")


if __name__ == "__main__":
    main()












"""
================================================================================
 ETAPE 2 - EXTRACTION D'INFORMATION - JUSTIFICATIF IDENTITE.PDF
================================================================================
Pre-requis :
    pip install -U transformers einops pymupdf pillow pytesseract mrz opencv-python-headless
    apt-get install tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara

Ce script reprend l'implementation precedente en corrigeant 2 problemes reels :

  A) "Aucune MRZ detectee" sur des documents qui en ont pourtant une.
     Causes les plus frequentes, dans l'ordre de probabilite :
       1. La CNI biometrique algerienne porte sa MRZ au VERSO de la carte.
          Si le scan du recto est mis avant/au lieu du verso, ou si le verso
          est mal cadre, la MRZ n'est simplement jamais dans le champ scanne
          sur cette page -> il faut bien parcourir TOUTES les pages (deja
          fait), et le pre-traitement doit fiabiliser la lecture du verso.
       2. Mauvaise rotation du scan (page a 90/180/270°, ou legerement
          inclinee) : un texte a l'envers n'est reconnu ni par le VLM ni
          par Tesseract -> ajout d'une correction de rotation automatique.
       3. Mauvaise qualite d'image (contraste faible, bruit, flou de scan) ->
          ajout d'un rehaussement (CLAHE + debruitage + nettete) avant OCR,
          et d'un traitement dedie (upscale + binarisation) pour la bande MRZ
          qui est en tres petits caracteres.
       4. La zone de recherche de la bande MRZ (bas de l'image) etait fixe a
          25% -> le script tente maintenant plusieurs decoupes (25/35/45%)
          pour absorber les marges de scan variables.

  B) Erreurs au chargement du modele PaddleOCR-VL :
       - "No module named 'einops'"            -> dependance manquante
       - "Unrecognized keys in 'rope_parameters' for 'rope_type'='default'"
         -> incompatibilite entre la version de 'transformers' installee et
            le format de configuration attendu par le modele (le champ
            'rope_scaling' a change de schema entre versions de transformers)
     Le script detecte ces erreurs specifiquement et affiche un message
     explicite avec la marche a suivre, au lieu de planter sans explication.
================================================================================
"""

import re
import csv
import json
import unicodedata
from pathlib import Path
