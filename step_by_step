"""
================================================================================
 SCRIPT D'EXTRACTION DES DOCUMENTS KYC
================================================================================
Objectif :
  1. Dézipper kyc_docs.zip
  2. Parcourir chaque dossier client
  3. Repérer uniquement les 5 fichiers PDF cibles (peu importe la casse,
     les espaces ou les petites variations dans le nom)
  4. Copier ces fichiers trouvés dans un dossier de sortie structuré
     par client (utile pour l'étape suivante : OCR / extraction d'infos)
  5. Générer un rapport CSV indiquant, pour CHAQUE client, quels documents
     sont présents et lesquels sont manquants

Aucune donnée n'est modifiée dans le zip original : on travaille toujours
sur une copie extraite.
================================================================================
"""

import zipfile
import shutil
import csv
import re
import unicodedata
from pathlib import Path


# ------------------------------------------------------------------------
# ÉTAPE 0 - CONFIGURATION (à adapter si besoin)
# ------------------------------------------------------------------------
ZIP_PATH = Path("kyc_docs.zip")              # chemin vers l'archive
EXTRACT_DIR = Path("kyc_extracted")          # dossier où tout le zip est dézippé
OUTPUT_DIR = Path("kyc_documents_cibles")    # dossier de sortie (fichiers utiles uniquement)
REPORT_PATH = Path("rapport_presence_kyc.csv")  # rapport final

# Liste des documents recherchés (noms "logiques", sans se soucier de la casse)
# NB : j'ai gardé "CARTON SIGNATUTE" tel quel car c'est le nom réel indiqué,
# mais j'accepte aussi "SIGNATURE" au cas où le fichier serait mal nommé
# dans certains dossiers. Vous pouvez retirer cette tolérance si non désiré.
TARGET_DOCS = {
    "JUSTIFICATIF IDENTITE": ["justificatif identite"],
    "JUSTIFICATIF DOMICILE": ["justificatif domicile"],
    "CONVENTION COMPTE": ["convention compte"],
    "FATCA": ["fatca"],
    "CARTON SIGNATURE": ["carton signatute", "carton signature"],
}


# ------------------------------------------------------------------------
# ÉTAPE 1 - FONCTION DE NORMALISATION DES NOMS DE FICHIERS
# ------------------------------------------------------------------------
def normaliser(texte: str) -> str:
    """
    Met le texte en minuscule, retire les accents, la ponctuation
    et les espaces multiples, pour pouvoir comparer les noms de fichiers
    de façon fiable même s'ils ne sont pas parfaitement identiques.
    """
    texte = texte.lower()
    texte = unicodedata.normalize("NFKD", texte).encode("ascii", "ignore").decode("utf-8")
    texte = re.sub(r"\.pdf$", "", texte)          # retire l'extension
    texte = re.sub(r"[^a-z0-9]+", " ", texte)      # remplace ponctuation/underscores par espace
    texte = re.sub(r"\s+", " ", texte).strip()     # espaces multiples -> un seul
    return texte


# ------------------------------------------------------------------------
# ÉTAPE 2 - DÉZIPPER L'ARCHIVE
# ------------------------------------------------------------------------
def dezipper(zip_path: Path, extract_dir: Path) -> None:
    if not zip_path.exists():
        raise FileNotFoundError(f"Archive introuvable : {zip_path}")

    extract_dir.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(zip_path, "r") as archive:
        archive.extractall(extract_dir)

    print(f"[OK] Archive dézippée dans : {extract_dir.resolve()}")


# ------------------------------------------------------------------------
# ÉTAPE 3 - REPÉRER LES DOSSIERS CLIENTS
# ------------------------------------------------------------------------
def lister_dossiers_clients(extract_dir: Path) -> list[Path]:
    """
    Retourne la liste des dossiers de premier niveau dans extract_dir.
    Chaque dossier = un identifiant client.
    Gère le cas où le zip contient un seul dossier racine englobant
    tous les dossiers clients.
    """
    contenu = [p for p in extract_dir.iterdir() if p.is_dir()]

    # Si le zip contient un seul dossier racine (ex: "kyc_docs/"),
    # on descend d'un niveau pour trouver les vrais dossiers clients.
    if len(contenu) == 1 and contenu[0].is_dir():
        sous_contenu = [p for p in contenu[0].iterdir() if p.is_dir()]
        if sous_contenu:
            return sous_contenu

    return contenu


# ------------------------------------------------------------------------
# ÉTAPE 4 - CHERCHER LES DOCUMENTS CIBLES DANS UN DOSSIER CLIENT
# ------------------------------------------------------------------------
def trouver_documents_cibles(dossier_client: Path) -> dict:
    """
    Parcourt tous les PDF du dossier client (récursivement, au cas où
    il y aurait des sous-dossiers) et associe chaque document cible
    au fichier trouvé correspondant (ou None si absent).
    """
    pdfs_du_dossier = list(dossier_client.rglob("*.pdf")) + list(dossier_client.rglob("*.PDF"))

    resultats = {nom_cible: None for nom_cible in TARGET_DOCS}

    for pdf in pdfs_du_dossier:
        nom_normalise = normaliser(pdf.stem)
        for nom_cible, variantes in TARGET_DOCS.items():
            if resultats[nom_cible] is not None:
                continue  # déjà trouvé
            for variante in variantes:
                if normaliser(variante) == nom_normalise:
                    resultats[nom_cible] = pdf
                    break

    return resultats


# ------------------------------------------------------------------------
# ÉTAPE 5 - COPIER LES FICHIERS TROUVÉS DANS LE DOSSIER DE SORTIE
# ------------------------------------------------------------------------
def copier_documents(client_id: str, resultats: dict, output_dir: Path) -> None:
    dossier_sortie_client = output_dir / client_id
    dossier_sortie_client.mkdir(parents=True, exist_ok=True)

    for nom_cible, chemin_source in resultats.items():
        if chemin_source is not None:
            nom_fichier_sortie = f"{nom_cible}.pdf"
            shutil.copy2(chemin_source, dossier_sortie_client / nom_fichier_sortie)


# ------------------------------------------------------------------------
# ÉTAPE 6 - FONCTION PRINCIPALE
# ------------------------------------------------------------------------
def main():
    # 1. Dézipper
    dezipper(ZIP_PATH, EXTRACT_DIR)

    # 2. Lister les dossiers clients
    dossiers_clients = lister_dossiers_clients(EXTRACT_DIR)
    print(f"[INFO] {len(dossiers_clients)} dossier(s) client trouvé(s).")

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    lignes_rapport = []
    noms_colonnes = ["client_id"] + list(TARGET_DOCS.keys()) + ["documents_manquants"]

    # 3. Traiter chaque dossier client
    for dossier in sorted(dossiers_clients):
        client_id = dossier.name
        resultats = trouver_documents_cibles(dossier)

        # Copier les fichiers trouvés
        copier_documents(client_id, resultats, OUTPUT_DIR)

        # Construire la ligne du rapport
        ligne = {"client_id": client_id}
        manquants = []
        for nom_cible in TARGET_DOCS:
            present = resultats[nom_cible] is not None
            ligne[nom_cible] = "Oui" if present else "Non"
            if not present:
                manquants.append(nom_cible)
        ligne["documents_manquants"] = ", ".join(manquants) if manquants else "Aucun"

        lignes_rapport.append(ligne)

    # 4. Écrire le rapport CSV
    with open(REPORT_PATH, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=noms_colonnes, delimiter=";")
        writer.writeheader()
        writer.writerows(lignes_rapport)

    print(f"[OK] Rapport généré : {REPORT_PATH.resolve()}")
    print(f"[OK] Documents extraits dans : {OUTPUT_DIR.resolve()}")

    # 5. Résumé rapide en console
    total = len(lignes_rapport)
    complets = sum(1 for l in lignes_rapport if l["documents_manquants"] == "Aucun")
    print(f"[RÉSUMÉ] {complets}/{total} dossiers clients ont les 5 documents complets.")


if __name__ == "__main__":
    main()















"""
================================================================================
 EXTRACTION D'INFORMATION - JUSTIFICATIF IDENTITE.PDF
================================================================================
Pré-requis (à installer dans l'environnement Domino) :
    pip install pymupdf pillow pytesseract mrz transformers torch
    + le paquet système tesseract-ocr avec les langues fra + ara :
        apt-get install tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara

Ce script :
  1. Parcourt chaque dossier client dans kyc_documents_cibles/ (généré par
     le script précédent)
  2. Convertit JUSTIFICATIF IDENTITE.PDF (multi-pages) en images
  3. Lance l'OCR bilingue (arabe + français) via le VLM PaddleOCR-VL local
  4. Détecte : type de document (CNI / permis de conduire / passeport),
     nationalité algérienne, et présence de la MRZ (document biométrique)
  5. Utilise une approche hybride pour la MRZ :
       - lecture du texte MRZ via le VLM (regex sur les lignes)
       - lecture du texte MRZ via une bande image dédiée + Tesseract
       - les deux se recoupent / se valident mutuellement
  6. Parse les champs de la MRZ (règles TD1 pour CNI, TD3 pour passeport)
     et traduit les libellés en français
  7. Génère deux rapports :
       - rapport_extraction_identite.csv  -> détail complet par client
       - rapport_mrz_clients.csv          -> qui a une MRZ extraite ou pas
================================================================================
"""

import re
import csv
import json
import unicodedata
from pathlib import Path
from dataclasses import dataclass, field, asdict

import fitz  # PyMuPDF
from PIL import Image
import pytesseract


# ------------------------------------------------------------------------
# ÉTAPE 0 - CONFIGURATION
# ------------------------------------------------------------------------
DOCUMENTS_DIR = Path("kyc_documents_cibles")          # sortie du script précédent
NOM_FICHIER_IDENTITE = "JUSTIFICATIF IDENTITE.pdf"
RAPPORT_DETAIL = Path("rapport_extraction_identite.csv")
RAPPORT_MRZ = Path("rapport_mrz_clients.csv")

PADDLEOCR_VL_PATH = "/domino/edv/modelhub/ModelHub-model-huggingface-PaddlePaddle/PaddleOCR-VL/main"

DPI_CONVERSION = 300  # résolution de rendu des pages PDF -> image


# ------------------------------------------------------------------------
# ÉTAPE 1 - CHARGEMENT DU MODÈLE VLM PADDLEOCR-VL (local, chargé une seule fois)
# ------------------------------------------------------------------------
_MODEL_CACHE = {}

def get_paddleocr_vl():
    """
    Charge le modèle une seule fois (singleton) pour éviter de le recharger
    à chaque appel.
    ATTENTION : l'API exacte (AutoModel/AutoProcessor vs API maison
    PaddleOCR-VL) dépend de la façon dont le modèle est packagé sur votre
    ModelHub. Vérifiez le README du dossier du modèle et adaptez si besoin.
    """
    if "model" not in _MODEL_CACHE:
        from transformers import AutoModel, AutoProcessor
        processor = AutoProcessor.from_pretrained(PADDLEOCR_VL_PATH, trust_remote_code=True)
        model = AutoModel.from_pretrained(PADDLEOCR_VL_PATH, trust_remote_code=True)
        model.eval()
        _MODEL_CACHE["model"] = model
        _MODEL_CACHE["processor"] = processor
    return _MODEL_CACHE["processor"], _MODEL_CACHE["model"]


def ocr_vlm(image: Image.Image) -> str:
    """
    Lance l'OCR sur une image via le VLM. Le prompt demande explicitement
    de restituer le texte tel quel (bilingue arabe/français), sans traduire,
    car on a besoin du texte brut pour la détection de mots-clés dans les
    deux langues.
    """
    processor, model = get_paddleocr_vl()
    prompt = "Extrait tout le texte visible sur ce document, tel quel, sans le traduire."
    inputs = processor(images=image, text=prompt, return_tensors="pt")
    sortie = model.generate(**inputs, max_new_tokens=2048)
    texte = processor.batch_decode(sortie, skip_special_tokens=True)[0]
    return texte


# ------------------------------------------------------------------------
# ÉTAPE 2 - CONVERSION PDF -> IMAGES (une image par page)
# ------------------------------------------------------------------------
def pdf_vers_images(pdf_path: Path, dpi: int = DPI_CONVERSION) -> list[Image.Image]:
    doc = fitz.open(pdf_path)
    zoom = dpi / 72
    matrice = fitz.Matrix(zoom, zoom)
    images = []
    for page in doc:
        pix = page.get_pixmap(matrix=matrice)
        img = Image.frombytes("RGB", [pix.width, pix.height], pix.samples)
        images.append(img)
    doc.close()
    return images


# ------------------------------------------------------------------------
# ÉTAPE 3 - NORMALISATION DE TEXTE POUR RECHERCHE DE MOTS-CLÉS BILINGUES
# ------------------------------------------------------------------------
def normaliser_recherche(texte: str) -> str:
    """
    Minuscules + suppression des diacritiques (accents latins ET tachkil
    arabe, qui sont techniquement des caractères combinants Unicode).
    Permet de matcher "Algérienne"/"algerienne" et le arabe avec ou sans
    voyellation.
    """
    texte = texte.lower()
    texte = unicodedata.normalize("NFKD", texte)
    texte = "".join(c for c in texte if not unicodedata.combining(c))
    return texte


def contient_un_des_mots_cles(texte_normalise: str, mots_cles: list[str]) -> bool:
    for mot in mots_cles:
        if normaliser_recherche(mot) in texte_normalise:
            return True
    return False


# Mots-clés bilingues (français + arabe) pour chaque type de document
MOTS_CLES_TYPE_DOCUMENT = {
    "Carte Nationale d'Identite": [
        "carte nationale d'identite", "carte d'identite", "cni",
        "بطاقة التعريف الوطنية", "بطاقة تعريف وطنية",
    ],
    "Permis de Conduire": [
        "permis de conduire",
        "رخصة السياقة", "رخصة سياقة",
    ],
    "Passeport": [
        "passeport",
        "جواز سفر", "جواز السفر",
    ],
}

MOTS_CLES_ALGERIE = [
    "republique algerienne democratique et populaire",
    "الجمهورية الجزائرية الديمقراطية الشعبية",
    "algerienne", "algerien", "الجزائر", "جزائرية", "جزائري",
]


def detecter_type_document(texte_ocr: str) -> str:
    texte_norm = normaliser_recherche(texte_ocr)
    for type_doc, mots_cles in MOTS_CLES_TYPE_DOCUMENT.items():
        if contient_un_des_mots_cles(texte_norm, mots_cles):
            return type_doc
    return "Indetermine"


def detecter_document_algerien(texte_ocr: str) -> bool:
    texte_norm = normaliser_recherche(texte_ocr)
    return contient_un_des_mots_cles(texte_norm, MOTS_CLES_ALGERIE)


# ------------------------------------------------------------------------
# ÉTAPE 4 - DÉTECTION MRZ - APPROCHE 1 : via le texte OCR du VLM (regex)
# ------------------------------------------------------------------------
# Une ligne MRZ ne contient que des majuscules, chiffres et '<', et fait
# généralement 30 caractères (format TD1 - cartes/CNI) ou 44 (TD3 - passeport)
MRZ_LIGNE_PATTERN = re.compile(r'^[A-Z0-9<]{28,44}$')

def detecter_lignes_mrz_dans_texte(texte_ocr: str) -> list[str]:
    lignes_brutes = [l.strip().upper().replace(" ", "") for l in texte_ocr.splitlines()]
    lignes_mrz = [l for l in lignes_brutes if MRZ_LIGNE_PATTERN.match(l) and l.count("<") >= 2]
    return lignes_mrz


# ------------------------------------------------------------------------
# ÉTAPE 5 - DÉTECTION MRZ - APPROCHE 2 : bande image dédiée + Tesseract
# ------------------------------------------------------------------------
def extraire_bande_mrz(image: Image.Image) -> Image.Image:
    """La MRZ se trouve généralement dans les ~25% inférieurs du document."""
    largeur, hauteur = image.size
    haut = int(hauteur * 0.75)
    return image.crop((0, haut, largeur, hauteur))


def ocr_bande_mrz_tesseract(bande: Image.Image) -> list[str]:
    config = "--psm 6 -c tessedit_char_whitelist=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789<"
    texte = pytesseract.image_to_string(bande, config=config, lang="eng")
    lignes_brutes = [l.strip().upper().replace(" ", "") for l in texte.splitlines() if l.strip()]
    lignes_valides = [l for l in lignes_brutes if MRZ_LIGNE_PATTERN.match(l)]
    return lignes_valides


# ------------------------------------------------------------------------
# ÉTAPE 6 - EXTRACTION MRZ HYBRIDE (les deux méthodes se recoupent)
# ------------------------------------------------------------------------
def extraire_mrz_hybride(image: Image.Image, texte_ocr_vlm: str) -> tuple[list[str], str]:
    lignes_vlm = detecter_lignes_mrz_dans_texte(texte_ocr_vlm)
    bande = extraire_bande_mrz(image)
    lignes_lib = ocr_bande_mrz_tesseract(bande)

    if lignes_vlm and lignes_lib:
        # Les deux méthodes ont trouvé quelque chose : on croise les résultats.
        # On retient la source qui donne un nombre de lignes cohérent avec un
        # format MRZ standard (2 ou 3 lignes), en priorisant le VLM si les deux
        # sont valides (généralement plus fiable sur du texte mixte).
        if len(lignes_vlm) in (2, 3):
            return lignes_vlm, "VLM + Bibliotheque MRZ (recoupement, VLM retenu)"
        elif len(lignes_lib) in (2, 3):
            return lignes_lib, "VLM + Bibliotheque MRZ (recoupement, Bibliotheque retenue)"
        else:
            return lignes_vlm, "VLM + Bibliotheque MRZ (recoupement partiel)"
    elif lignes_vlm:
        return lignes_vlm, "VLM uniquement"
    elif lignes_lib:
        return lignes_lib, "Bibliotheque MRZ uniquement"
    else:
        return [], "Aucune"


# ------------------------------------------------------------------------
# ÉTAPE 7 - PARSING DES CHAMPS MRZ (règles TD1 pour CNI, TD3 pour passeport)
# ------------------------------------------------------------------------
def formater_date_mrz(date_aaMMjj: str) -> str:
    """Convertit une date MRZ 'AAMMJJ' en 'JJ/MM/AAAA' (heuristique < 30 = 20xx)."""
    if not date_aaMMjj or len(date_aaMMjj) != 6 or not date_aaMMjj.isdigit():
        return ""
    aa, mm, jj = date_aaMMjj[0:2], date_aaMMjj[2:4], date_aaMMjj[4:6]
    siecle = "20" if int(aa) <= 30 else "19"
    return f"{jj}/{mm}/{siecle}{aa}"


def traduire_sexe(code_sexe: str) -> str:
    return {"M": "Masculin", "F": "Feminin"}.get(code_sexe, "Indetermine")


def parser_mrz(lignes: list[str]) -> dict:
    """
    Parse les lignes MRZ selon le format détecté (TD1 = 3 lignes / CNI,
    TD3 = 2 lignes / passeport) et restitue les champs en français.

    NOTE : l'API du package `mrz` (TD1CodeChecker / TD3CodeChecker,
    et les noms d'attributs sur `.fields()`) est à vérifier contre la
    version installée dans votre environnement - ajustez si nécessaire.
    """
    try:
        if len(lignes) == 3 and all(len(l) >= 28 for l in lignes):
            from mrz.checker.td1 import TD1CodeChecker
            texte_mrz = "\n".join(l[:30].ljust(30, "<") for l in lignes)
            checker = TD1CodeChecker(texte_mrz)
            champs = checker.fields()
            format_mrz = "TD1 (carte d'identite)"
        elif len(lignes) == 2 and all(len(l) >= 40 for l in lignes):
            from mrz.checker.td3 import TD3CodeChecker
            texte_mrz = "\n".join(l[:44].ljust(44, "<") for l in lignes)
            checker = TD3CodeChecker(texte_mrz)
            champs = checker.fields()
            format_mrz = "TD3 (passeport)"
        else:
            return {"erreur_parsing_mrz": f"Nombre/longueur de lignes inattendu ({len(lignes)})"}

        return {
            "format_mrz": format_mrz,
            "mrz_valide": bool(checker),
            "nom": getattr(champs, "surname", ""),
            "prenom": getattr(champs, "name", ""),
            "numero_document": getattr(champs, "document_number", ""),
            "date_naissance": formater_date_mrz(getattr(champs, "birth_date", "")),
            "sexe": traduire_sexe(getattr(champs, "sex", "")),
            "date_expiration": formater_date_mrz(getattr(champs, "expiry_date", "")),
            "nationalite": getattr(champs, "nationality", ""),
            "pays_emetteur": getattr(champs, "country", ""),
        }
    except Exception as e:
        return {"erreur_parsing_mrz": str(e)}


# ------------------------------------------------------------------------
# ÉTAPE 8 - STRUCTURE DE RÉSULTAT PAR CLIENT
# ------------------------------------------------------------------------
@dataclass
class ResultatIdentite:
    client_id: str
    fichier_trouve: bool = False
    nb_pages: int = 0
    type_document: str = "Non traite"
    document_algerien: str = "Indetermine"
    biometrique: str = "Non"
    mrz_detectee: str = "Non"
    methode_mrz: str = "Aucune"
    mrz_brute: str = ""
    informations_mrz: dict = field(default_factory=dict)
    erreur: str = ""


# ------------------------------------------------------------------------
# ÉTAPE 9 - TRAITEMENT D'UN CLIENT
# ------------------------------------------------------------------------
def traiter_client(dossier_client: Path) -> ResultatIdentite:
    client_id = dossier_client.name
    resultat = ResultatIdentite(client_id=client_id)

    pdf_path = dossier_client / NOM_FICHIER_IDENTITE
    if not pdf_path.exists():
        resultat.erreur = "JUSTIFICATIF IDENTITE.pdf absent de ce dossier"
        return resultat

    resultat.fichier_trouve = True

    try:
        images = pdf_vers_images(pdf_path)
        resultat.nb_pages = len(images)

        texte_toutes_pages = []
        lignes_mrz_trouvees: list[str] = []
        methode_mrz_retenue = "Aucune"

        # On parcourt les pages : on cumule le texte pour la détection du
        # type de document, et on cherche la MRZ page par page (on s'arrête
        # dès qu'on la trouve, car elle n'apparaît que sur une seule page).
        for image in images:
            texte_page = ocr_vlm(image)
            texte_toutes_pages.append(texte_page)

            if not lignes_mrz_trouvees:
                lignes, methode = extraire_mrz_hybride(image, texte_page)
                if lignes:
                    lignes_mrz_trouvees = lignes
                    methode_mrz_retenue = methode

        texte_complet = "\n".join(texte_toutes_pages)

        # Détection du type de document et de la nationalité
        resultat.type_document = detecter_type_document(texte_complet)
        resultat.document_algerien = "Oui" if detecter_document_algerien(texte_complet) else "Non"

        # MRZ -> document biométrique
        if lignes_mrz_trouvees:
            resultat.mrz_detectee = "Oui"
            resultat.methode_mrz = methode_mrz_retenue
            resultat.mrz_brute = " | ".join(lignes_mrz_trouvees)
            resultat.biometrique = "Oui"
            resultat.informations_mrz = parser_mrz(lignes_mrz_trouvees)
        else:
            resultat.mrz_detectee = "Non"
            resultat.methode_mrz = "Aucune"
            resultat.biometrique = "Non"

    except Exception as e:
        resultat.erreur = f"Erreur de traitement : {e}"

    return resultat


# ------------------------------------------------------------------------
# ÉTAPE 10 - FONCTION PRINCIPALE : parcourt tous les clients, écrit les rapports
# ------------------------------------------------------------------------
def main():
    dossiers_clients = sorted([p for p in DOCUMENTS_DIR.iterdir() if p.is_dir()])
    print(f"[INFO] {len(dossiers_clients)} dossier(s) client à traiter.")

    resultats = []
    for dossier in dossiers_clients:
        print(f"[TRAITEMENT] {dossier.name} ...")
        resultats.append(traiter_client(dossier))

    # --- Rapport détaillé complet ---
    with open(RAPPORT_DETAIL, "w", newline="", encoding="utf-8-sig") as f:
        colonnes = [
            "client_id", "fichier_trouve", "nb_pages", "type_document",
            "document_algerien", "biometrique", "mrz_detectee", "methode_mrz",
            "mrz_brute", "informations_mrz", "erreur",
        ]
        writer = csv.DictWriter(f, fieldnames=colonnes, delimiter=";")
        writer.writeheader()
        for r in resultats:
            ligne = asdict(r)
            ligne["informations_mrz"] = json.dumps(r.informations_mrz, ensure_ascii=False)
            writer.writerow(ligne)

    # --- Rapport dédié MRZ : qui a une MRZ extraite, qui n'en a pas ---
    with open(RAPPORT_MRZ, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.writer(f, delimiter=";")
        writer.writerow(["client_id", "mrz_detectee", "methode_mrz", "type_document", "raison_absence"])
        for r in resultats:
            raison = ""
            if r.mrz_detectee != "Oui":
                if not r.fichier_trouve:
                    raison = "Fichier JUSTIFICATIF IDENTITE.pdf absent"
                elif r.erreur:
                    raison = r.erreur
                elif r.type_document == "Permis de Conduire":
                    raison = "Document generalement non biometrique"
                else:
                    raison = "MRZ non detectee sur le scan (qualite image / document ancien format)"
            writer.writerow([r.client_id, r.mrz_detectee, r.methode_mrz, r.type_document, raison])

    # --- Résumé console ---
    total = len(resultats)
    avec_mrz = sum(1 for r in resultats if r.mrz_detectee == "Oui")
    sans_mrz = total - avec_mrz
    print(f"[OK] Rapport détaillé : {RAPPORT_DETAIL.resolve()}")
    print(f"[OK] Rapport MRZ      : {RAPPORT_MRZ.resolve()}")
    print(f"[RÉSUMÉ] {avec_mrz}/{total} clients avec MRZ extraite, {sans_mrz}/{total} sans MRZ.")


if __name__ == "__main__":
    main()
